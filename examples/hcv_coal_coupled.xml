<run id="mcmc" spec="coupledMCMC.CoupledMCMC" chainLength="25000000" storeEvery="10000" deltaTemperature="0.05" chains="4" resampleEvery="1000">
    <state id="state" storeEvery="5000">
        <tree id="Tree.t:hcv" name="stateNode">
            <taxonset id="TaxonSet.hcv" spec="TaxonSet">
                <alignment idref="hcv"/>
            </taxonset>
        </tree>
        <parameter id="gammaShape.s:hcv" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter id="rateAC.s:hcv" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter id="rateAG.s:hcv" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter id="rateAT.s:hcv" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter id="rateCG.s:hcv" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter id="rateGT.s:hcv" name="stateNode" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        <parameter id="bPopSizes.t:hcv" dimension="4" name="stateNode" value="380.0" spec="beast.base.spec.inference.parameter.RealVectorParam" domain="PositiveReal"/>
        <stateNode id="bGroupSizes.t:hcv" dimension="4" value="1" spec="beast.base.spec.inference.parameter.IntSimplexParam" domain="PositiveInt"/>
        <parameter id="freqParameter.s:hcv" dimension="4" name="stateNode" value="0.25" spec="beast.base.spec.inference.parameter.SimplexParam"/>
    </state>

    <init id="RandomTree.t:hcv" spec="beast.base.spec.evolution.tree.coalescent.RandomTree" estimate="false" initial="@Tree.t:hcv" taxa="@hcv">
        <populationModel id="ConstantPopulation0.t:hcv" spec="beast.base.spec.evolution.tree.coalescent.ConstantPopulation">
            <parameter id="randomPopSize.t:hcv" name="popSize" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
        </populationModel>
    </init>

    <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">
        <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
            <distribution id="BayesianSkyline.t:hcv" spec="beast.base.spec.evolution.tree.coalescent.BayesianSkyline" groupSizes="@bGroupSizes.t:hcv" popSizes="@bPopSizes.t:hcv">
                <treeIntervals id="BSPTreeIntervals.t:hcv" spec="beast.base.evolution.tree.TreeIntervals" tree="@Tree.t:hcv"/>
            </distribution>
            <distribution id="MarkovChainedPopSizes.t:hcv" spec="beast.base.spec.inference.distribution.MarkovChainDistribution" jeffreys="true" param="@bPopSizes.t:hcv"/>
            <distribution id="Exponential.0" spec="beast.base.spec.inference.distribution.Exponential" param="@gammaShape.s:hcv">
                    <parameter id="RealParameter.0" name="mean" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </distribution>
            <distribution id="Gamma.0" spec="beast.base.spec.inference.distribution.Gamma" param="@rateAC.s:hcv">
                    <parameter id="RealParameter.01" estimate="false" name="alpha" value="0.05" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                    <parameter id="RealParameter.02" estimate="false" name="theta" value="10.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </distribution>
            <distribution id="Gamma.01" spec="beast.base.spec.inference.distribution.Gamma" param="@rateAG.s:hcv">
                    <parameter id="RealParameter.03" estimate="false" name="alpha" value="0.05" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                    <parameter id="RealParameter.04" estimate="false" name="theta" value="20.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </distribution>
            <distribution id="Gamma.02" spec="beast.base.spec.inference.distribution.Gamma" param="@rateAT.s:hcv">
                    <parameter id="RealParameter.05" estimate="false" name="alpha" value="0.05" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                    <parameter id="RealParameter.06" estimate="false" name="theta" value="10.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </distribution>
            <distribution id="Gamma.03" spec="beast.base.spec.inference.distribution.Gamma" param="@rateCG.s:hcv">
                    <parameter id="RealParameter.07" estimate="false" name="alpha" value="0.05" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                    <parameter id="RealParameter.08" estimate="false" name="theta" value="10.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </distribution>
            <distribution id="Gamma.04" spec="beast.base.spec.inference.distribution.Gamma" param="@rateGT.s:hcv">
                    <parameter id="RealParameter.09" estimate="false" name="alpha" value="0.05" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                    <parameter id="RealParameter.010" estimate="false" name="theta" value="10.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </distribution>
        </distribution>
        <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution" useThreads="true">
            <distribution id="treeLikelihood.hcv" spec="beast.base.spec.evolution.likelihood.ThreadedTreeLikelihood" data="@hcv" tree="@Tree.t:hcv">
                <siteModel id="SiteModel.s:hcv" spec="beast.base.spec.evolution.sitemodel.SiteModel" gammaCategoryCount="4" shape="@gammaShape.s:hcv">
                    <parameter id="mutationRate.s:hcv" estimate="false" name="mutationRate" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                    <parameter id="proportionInvariant.s:hcv" estimate="false" name="proportionInvariant" value="0.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="UnitInterval"/>
                    <substModel id="gtr.s:hcv" spec="beast.base.spec.evolution.substitutionmodel.GTR" rateAC="@rateAC.s:hcv" rateAG="@rateAG.s:hcv" rateAT="@rateAT.s:hcv" rateCG="@rateCG.s:hcv" rateGT="@rateGT.s:hcv">
                        <parameter id="rateCT.s:hcv" estimate="false" name="rateCT" value="1.0" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                        <frequencies id="estimatedFreqs.s:hcv" spec="beast.base.spec.evolution.substitutionmodel.Frequencies" frequencies="@freqParameter.s:hcv"/>
                    </substModel>
                </siteModel>
                <branchRateModel id="StrictClock.c:hcv" spec="beast.base.spec.evolution.branchratemodel.StrictClockModel">
                    <parameter id="clockRate.c:hcv" estimate="false" name="clock.rate" value="7.9E-4" spec="beast.base.spec.inference.parameter.RealScalarParam" domain="PositiveReal"/>
                </branchRateModel>
            </distribution>
        </distribution>
    </distribution>

    <operator id="gammaShapeScaler.s:hcv" parameter="@gammaShape.s:hcv" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="RateACScaler.s:hcv" parameter="@rateAC.s:hcv" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="RateAGScaler.s:hcv" parameter="@rateAG.s:hcv" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="RateATScaler.s:hcv" parameter="@rateAT.s:hcv" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="RateCGScaler.s:hcv" parameter="@rateCG.s:hcv" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="RateGTScaler.s:hcv" parameter="@rateGT.s:hcv" scaleFactor="0.5" weight="0.1" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="BayesianSkylineTreeScaler.t:hcv" scaleFactor="0.5" tree="@Tree.t:hcv" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

    <operator id="BayesianSkylineTreeRootScaler.t:hcv" rootOnly="true" scaleFactor="0.5" tree="@Tree.t:hcv" weight="3.0" spec="beast.base.spec.evolution.operator.ScaleTreeOperator"/>

    <operator id="BayesianSkylineUniformOperator.t:hcv" tree="@Tree.t:hcv" weight="30.0" spec="beast.base.evolution.operator.Uniform"/>

    <operator id="BayesianSkylineSubtreeSlide.t:hcv" spec="beast.base.evolution.operator.kernel.BactrianSubtreeSlide" tree="@Tree.t:hcv" weight="15.0"/>

    <operator id="BayesianSkylineNarrow.t:hcv" spec="Exchange" tree="@Tree.t:hcv" weight="15.0"/>

    <operator id="BayesianSkylineWide.t:hcv" spec="Exchange" isNarrow="false" tree="@Tree.t:hcv" weight="3.0"/>

    <operator id="BayesianSkylineWilsonBalding.t:hcv" spec="WilsonBalding" tree="@Tree.t:hcv" weight="3.0"/>

    <operator id="popSizesScaler.t:hcv" parameter="@bPopSizes.t:hcv" scaleFactor="0.75" weight="15.0" spec="beast.base.spec.inference.operator.ScaleOperator"/>

    <operator id="groupSizesDelta.t:hcv" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" weight="6.0">
        <ivparameter idref="bGroupSizes.t:hcv"/>
    </operator>

    <operator id="FrequenciesExchanger.s:hcv" spec="beast.base.spec.inference.operator.DeltaExchangeOperator" delta="0.01" weight="0.1">
        <parameter idref="freqParameter.s:hcv"/>
    </operator>

    <logger id="tracelog" fileName="$(filebase).log" logEvery="1000" model="@posterior" sanitiseHeaders="true" sort="smart">
        <log id="DummyLogger" spec="coupledMCMC.DummyLogger"/>
        <log idref="posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
        <log idref="treeLikelihood.hcv"/>
        <log id="TreeHeight.t:hcv" spec="beast.base.evolution.tree.TreeStatLogger" tree="@Tree.t:hcv"/>
        <log idref="gammaShape.s:hcv"/>
        <log idref="rateAC.s:hcv"/>
        <log idref="rateAG.s:hcv"/>
        <log idref="rateAT.s:hcv"/>
        <log idref="rateCG.s:hcv"/>
        <log idref="rateGT.s:hcv"/>
        <log idref="BayesianSkyline.t:hcv"/>
        <log idref="bPopSizes.t:hcv"/>
        <log idref="bGroupSizes.t:hcv"/>
        <log idref="freqParameter.s:hcv"/>
    </logger>

    <logger id="screenlog" logEvery="1000">
        <log idref="posterior"/>
        <log id="ESS.0" spec="beast.base.spec.inference.util.ESS" arg="@posterior"/>
        <log idref="likelihood"/>
        <log idref="prior"/>
    </logger>

    <logger id="treelog.t:hcv" fileName="$(filebase).trees" logEvery="1000" mode="tree">
        <log id="TreeWithMetaDataLogger.t:hcv" spec="beast.base.spec.evolution.TreeWithMetaDataLogger" tree="@Tree.t:hcv"/>
    </logger>

</run>

</beast>
